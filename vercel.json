{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/smtp/send", "destination": "/api/smtp/send" },
    { "source": "/api/smtp/test", "destination": "/api/smtp/test" },
    { "source": "/api/auth/send-otp", "destination": "/api/auth/send-otp" },
    { "source": "/api/auth/reset-password", "destination": "/api/auth/reset-password" },
    { "source": "/api/auth/verify-credentials", "destination": "/api/auth/verify-credentials" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ]
}
